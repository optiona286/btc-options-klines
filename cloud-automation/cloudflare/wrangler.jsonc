{
  "name": "btc-op-daily-scheduler",
  "main": "worker.mjs",
  "compatibility_date": "2026-10-18",
  "workers_dev": true,
  "triggers": {
    "crons": []
  },
  "vars": {
    "GITHUB_REPOSITORY": "optiona286/btc-options-klines",
    "GITHUB_BRANCH": "main",
    "GITHUB_WORKFLOW": "update-op-data.yml"
  },
  "observability": {
    "enabled": true
  }
}
